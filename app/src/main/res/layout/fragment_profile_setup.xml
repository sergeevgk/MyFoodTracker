<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <!-- Medical Disclaimer Banner (AC #3) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/warning_banner_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="0dp"
            app:strokeColor="@color/warning_banner_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_card_small"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_disclaimer"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/warning_banner_text" />

                <TextView
                    android:id="@+id/tvDisclaimer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="@string/profile_disclaimer"
                    android:textColor="@color/warning_banner_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_title_create"
                    android:textColor="@color/primary_forest"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_section" />

                <!-- Username Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsername"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:hint="@string/profile_hint_username"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Passcode Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPasscode"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card"
                    android:hint="@string/profile_hint_passcode"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasscode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_section_targets"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/padding_card_small" />

                <!-- Calorie Target -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCalorieTarget"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:hint="@string/profile_hint_calories"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCalorieTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Protein Target -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProteinTarget"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:hint="@string/profile_hint_protein"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProteinTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Carb Target -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCarbTarget"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:hint="@string/profile_hint_carbs"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCarbTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Fat Target -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFatTarget"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:hint="@string/profile_hint_fat"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFatTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Water Target -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWaterTarget"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_large"
                    android:hint="@string/profile_hint_water"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWaterTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Create Profile Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/action_create_profile"
                    android:textColor="@color/surface_card_bg"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_forest"
                    app:cornerRadius="@dimen/radius_button_large" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
