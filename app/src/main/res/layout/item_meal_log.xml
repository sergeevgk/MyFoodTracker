<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_small"
    android:minHeight="@dimen/min_touch_target"
    app:cardBackgroundColor="@color/surface_card_bg"
    app:cardCornerRadius="@dimen/radius_card_small"
    app:cardElevation="1dp"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="vertical"
        android:padding="@dimen/padding_card_small">

        <TextView
            android:id="@+id/tv_meal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="LUNCH · 13:00" />

        <TextView
            android:id="@+id/tv_meal_food_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Office lunch" />

        <TextView
            android:id="@+id/tv_meal_macros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="500 kcal · P 20g · C 45g · F 15g" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
