<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_card">

        <TextView
            android:id="@+id/tv_log_food_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_tiny"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_log_food_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_card_small"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_log_food_quantity"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_card_small"
            android:hint="@string/log_food_hint_quantity"
            app:errorEnabled="true"
            app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
            app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
            app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
            app:boxCornerRadiusTopStart="@dimen/radius_card_small">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_log_food_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_log_food_unit"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_card_small"
            android:hint="@string/log_food_hint_unit"
            app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
            app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
            app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
            app:boxCornerRadiusTopStart="@dimen/radius_card_small">

            <AutoCompleteTextView
                android:id="@+id/spinner_log_food_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_log_food_slot"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_card_small"
            android:hint="@string/log_food_hint_meal_slot"
            app:errorEnabled="true"
            app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
            app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
            app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
            app:boxCornerRadiusTopStart="@dimen/radius_card_small">

            <AutoCompleteTextView
                android:id="@+id/spinner_log_food_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_log_food_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
