<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/padding_card">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card_large">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_title_welcome_back"
                    android:textColor="@color/primary_forest"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_subtitle_passcode"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="@dimen/padding_card" />

                <!-- Profile Selector Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProfileSelector"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_section"
                    android:hint="@string/auth_hint_profile"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <AutoCompleteTextView
                        android:id="@+id/actvProfileSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4-Digit Passcode Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPasscode"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_large"
                    android:hint="@string/auth_hint_passcode"
                    app:errorEnabled="true"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusBottomStart="@dimen/radius_card_small"
                    app:boxCornerRadiusTopEnd="@dimen/radius_card_small"
                    app:boxCornerRadiusTopStart="@dimen/radius_card_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPasscode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Remember Device Checkbox -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbRememberDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/auth_cb_remember_device"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:buttonTint="@color/primary_forest" />

                <!-- Unlock Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/action_unlock"
                    android:textColor="@color/surface_card_bg"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_forest"
                    app:cornerRadius="@dimen/radius_button_large" />

                <!-- Add New Profile Link -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNewProfile"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/action_add_new_profile"
                    android:textColor="@color/primary_forest"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/padding_card_small"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
