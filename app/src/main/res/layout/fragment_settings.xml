<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <!-- Active profile header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:id="@+id/tv_settings_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Signed in as Georgii" />

                <TextView
                    android:id="@+id/tv_settings_profile_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_tiny"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Active Profile ID: user-1" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Export logs -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:id="@+id/tv_export_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/settings_section_export"
                    android:textColor="@color/primary_forest"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_format_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/settings_format_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_format"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_tiny"
                    android:contentDescription="@string/settings_format_label"
                    app:checkedButton="@id/btn_format_csv"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_format_csv"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/settings_format_csv" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_format_txt"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/settings_format_txt" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/tv_date_range_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_section"
                    android:text="@string/settings_date_range_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_date_range"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_tiny"
                    android:fontFeatureSettings="tnum"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/settings_date_range_default"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    app:icon="@drawable/ic_calendar_today"
                    app:iconGravity="textStart"
                    app:iconTint="@color/primary_forest" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_section"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/settings_export_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_save"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/settings_export_save" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Attribution &amp; privacy notice — closes deferred item 3.5-D1 -->
        <TextView
            android:id="@+id/tv_settings_attribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/padding_card_large"
            android:text="@string/settings_attribution"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
