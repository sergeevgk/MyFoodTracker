<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_dashboard_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Dashboard"
                        android:textColor="#1B4D3E"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Calendar Picker Button -->
                        <ImageButton
                            android:id="@+id/ib_calendar_picker"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Select date from month calendar"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_calendar_today"
                            app:tint="#1B4D3E" />

                        <!-- Logout Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_logout"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:text="Log Out"
                            android:textColor="#BA1A1A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </RelativeLayout>

                <!-- Welcome Banner -->
                <TextView
                    android:id="@+id/tv_welcome_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome!"
                    android:textColor="#2D3748"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <!-- Active Profile Info -->
                <TextView
                    android:id="@+id/tv_active_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Active Profile ID: "
                    android:textColor="#718096"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Macro Progress Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_macro_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_macro_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Daily Progress"
                    android:textColor="#2D3748"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Calories block -->
                <TextView
                    android:id="@+id/tv_calories_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#1B4D3E"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="1,450 kcal" />

                <TextView
                    android:id="@+id/tv_calories_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#718096"
                    android:textSize="14sp"
                    tools:text="of 2,000 kcal" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_calories"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="16dp"
                    app:indicatorColor="#1B4D3E"
                    app:trackColor="#E2E8F0" />

                <!-- Protein row -->
                <LinearLayout
                    android:id="@+id/layout_protein_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Protein"
                            android:textColor="#718096"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_protein_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#2D3748"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="30g" />

                        <TextView
                            android:id="@+id/tv_protein_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#718096"
                            android:textSize="12sp"
                            tools:text=" / 120g" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_protein"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        app:indicatorColor="#2D6A4F"
                        app:trackColor="#E2E8F0" />

                </LinearLayout>

                <!-- Carbs row -->
                <LinearLayout
                    android:id="@+id/layout_carbs_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Carbs"
                            android:textColor="#718096"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_carbs_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#2D3748"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="45g" />

                        <TextView
                            android:id="@+id/tv_carbs_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#718096"
                            android:textSize="12sp"
                            tools:text=" / 200g" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_carbs"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        app:indicatorColor="#E9C46A"
                        app:trackColor="#E2E8F0" />

                </LinearLayout>

                <!-- Fat row -->
                <LinearLayout
                    android:id="@+id/layout_fat_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fat"
                            android:textColor="#718096"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_fat_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#2D3748"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="12g" />

                        <TextView
                            android:id="@+id/tv_fat_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#718096"
                            android:textSize="12sp"
                            tools:text=" / 65g" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_fat"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        app:indicatorColor="#E76F51"
                        app:trackColor="#E2E8F0" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Water Log Widget Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_water_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#E1F5FE"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_water_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Hydration"
                    android:textColor="#2D3748"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_water_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0 ml"
                    android:textColor="#0288D1"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="1,250 / 2,000 ml" />

                <TextView
                    android:id="@+id/tv_water_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#718096"
                    android:textSize="14sp"
                    tools:text="62% of daily goal" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_water"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    app:indicatorColor="#0288D1"
                    app:trackColor="#B3E5FC" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_water_250"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="+250ml"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#0288D1"
                    android:contentDescription="+250 milliliters water" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Week-View Navigation Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Navigation Controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:id="@+id/btn_prev_week"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous week"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="#1B4D3E" />

                    <TextView
                        android:id="@+id/tv_active_date_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#1B4D3E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Wednesday, Sep 30, 2026" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_today"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="Today"
                        android:textSize="13sp"
                        app:cornerRadius="24dp" />

                    <ImageButton
                        android:id="@+id/btn_next_week"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next week"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#1B4D3E" />

                </LinearLayout>

                <!-- Horizontal 7-Day Strip -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_week_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_week_day" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Meals Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_meals_section_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Logged Meals"
                        android:textColor="#2D3748"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_quick_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="＋ Quick Add"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#1B4D3E"
                        android:contentDescription="Quick-add calories and macros" />

                </LinearLayout>

                <!-- Empty Meals State -->
                <TextView
                    android:id="@+id/tv_empty_meals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No items logged for this date"
                    android:textColor="#718096"
                    android:textSize="14sp" />

                <!-- Meal Entries Container -->
                <LinearLayout
                    android:id="@+id/layout_meal_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_meal_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#2D3748"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
