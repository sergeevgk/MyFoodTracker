<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_screen">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small">

                    <TextView
                        android:id="@+id/tv_dashboard_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/dashboard_title"
                        android:textColor="@color/primary_forest"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Calendar Picker Button -->
                        <ImageButton
                            android:id="@+id/ib_calendar_picker"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="@dimen/min_touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_calendar_picker"
                            android:padding="@dimen/padding_card_small"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_calendar_today"
                            app:tint="@color/primary_forest" />

                        <!-- Logout Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_logout"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/min_touch_target"
                            android:layout_marginStart="@dimen/margin_tiny"
                            android:text="@string/action_logout"
                            android:textColor="@color/danger_red"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </RelativeLayout>

                <!-- Welcome Banner -->
                <TextView
                    android:id="@+id/tv_welcome_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_welcome_default"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/margin_tiny" />

                <!-- Active Profile Info -->
                <TextView
                    android:id="@+id/tv_active_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/active_profile_default"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Macro Progress Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_macro_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeColor="@color/surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:id="@+id/tv_macro_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:text="@string/dashboard_section_progress"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Calories block -->
                <TextView
                    android:id="@+id/tv_calories_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/macro_calories"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="1,450 kcal" />

                <TextView
                    android:id="@+id/tv_calories_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_tiny"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="of 2,000 kcal" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_calories"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="@dimen/margin_section"
                    app:indicatorColor="@color/macro_calories"
                    app:trackColor="@color/surface_stroke" />

                <!-- Protein row -->
                <LinearLayout
                    android:id="@+id/layout_protein_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dashboard_macro_protein"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_protein_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="30g" />

                        <TextView
                            android:id="@+id/tv_protein_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text=" / 120g" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_protein"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/margin_tiny"
                        app:indicatorColor="@color/macro_protein"
                        app:trackColor="@color/surface_stroke" />

                </LinearLayout>

                <!-- Carbs row -->
                <LinearLayout
                    android:id="@+id/layout_carbs_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/padding_card_small"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dashboard_macro_carbs"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_carbs_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="45g" />

                        <TextView
                            android:id="@+id/tv_carbs_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text=" / 200g" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_carbs"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/margin_tiny"
                        app:indicatorColor="@color/macro_carbs"
                        app:trackColor="@color/surface_stroke" />

                </LinearLayout>

                <!-- Fat row -->
                <LinearLayout
                    android:id="@+id/layout_fat_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dashboard_macro_fat"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_fat_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="12g" />

                        <TextView
                            android:id="@+id/tv_fat_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text=" / 65g" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_fat"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/margin_tiny"
                        app:indicatorColor="@color/macro_fat"
                        app:trackColor="@color/surface_stroke" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Water Log Widget Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_water_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/water_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:id="@+id/tv_water_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="@string/dashboard_section_hydration"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_water_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/dashboard_water_default"
                    android:textColor="@color/water_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="1,250 / 2,000 ml" />

                <TextView
                    android:id="@+id/tv_water_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="62% of daily goal" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_water"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/margin_small"
                    app:indicatorColor="@color/water_primary"
                    app:trackColor="@color/water_progress_track" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_water_250"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginTop="@dimen/padding_card_small"
                    android:minWidth="@dimen/min_touch_target"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/water_add_button"
                    android:textColor="@color/surface_card_bg"
                    app:backgroundTint="@color/water_primary"
                    android:contentDescription="@string/cd_add_water" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Week-View Navigation Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_section"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/padding_screen"
                android:paddingBottom="@dimen/padding_screen">

                <!-- Navigation Controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/padding_card_small"
                    android:paddingEnd="@dimen/padding_card_small"
                    android:layout_marginBottom="@dimen/padding_card_small">

                    <ImageButton
                        android:id="@+id/btn_prev_week"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="@dimen/min_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_prev_week"
                        android:padding="@dimen/padding_card_small"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/primary_forest" />

                    <TextView
                        android:id="@+id/tv_active_date_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/primary_forest"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Wednesday, Sep 30, 2026" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_today"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/min_touch_target"
                        android:layout_marginStart="@dimen/margin_tiny"
                        android:layout_marginEnd="@dimen/margin_tiny"
                        android:text="@string/action_today"
                        android:textSize="13sp"
                        app:cornerRadius="@dimen/radius_day_pill" />

                    <ImageButton
                        android:id="@+id/btn_next_week"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="@dimen/min_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_next_week"
                        android:padding="@dimen/padding_card_small"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary_forest" />

                </LinearLayout>

                <!-- Horizontal 7-Day Strip -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_week_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_small"
                    android:paddingEnd="@dimen/margin_small"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_week_day" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Meals Section Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card_bg"
            app:cardCornerRadius="@dimen/radius_card_medium"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/padding_card_small">

                    <TextView
                        android:id="@+id/tv_meals_section_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_section_meals"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_quick_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/min_touch_target"
                        android:minHeight="@dimen/min_touch_target"
                        android:text="@string/action_quick_add"
                        android:textColor="@color/surface_card_bg"
                        app:backgroundTint="@color/primary_forest"
                        android:contentDescription="@string/cd_quick_add" />

                </LinearLayout>

                <!-- Empty Meals State -->
                <TextView
                    android:id="@+id/tv_empty_meals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/padding_card_large"
                    android:text="@string/dashboard_empty_meals"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Meal Entries Container -->
                <LinearLayout
                    android:id="@+id/layout_meal_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_meal_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_meal_entries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_card_small"
                        android:clipToPadding="false"
                        android:contentDescription="@string/cd_meal_entries"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_meal_log" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
