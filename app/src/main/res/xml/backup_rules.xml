<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31 (see data_extraction_rules.xml
   for API 31+). See https://developer.android.com/guide/topics/data/autobackup
   for details.
-->
<full-backup-content>
    <!-- The restore staging directory must not be uploaded by the platform
         auto-backup while staged: it contains the database file selected for
         restore, which is about to replace the live one (resolves 5.2-F4). -->
    <exclude domain="file" path="pending_restore/" />
</full-backup-content>
