<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+ (cloud backup and device transfer).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The restore staging directory must not be uploaded by the platform
             auto-backup while staged: it contains the database file selected
             for restore, which is about to replace the live one (resolves
             5.2-F4). -->
        <exclude domain="file" path="pending_restore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pending_restore/" />
    </device-transfer>
</data-extraction-rules>
